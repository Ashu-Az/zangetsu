# ---- Naukri login (optional: leave blank to log in manually in the browser window) ----
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# ---- Anthropic ----
# Leave blank if you have run `ant auth login`; the SDK picks the profile up automatically.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Server-side refusal fallbacks (Claude API only). Set to 0 to disable.
LLM_FALLBACKS=1

# ---- Search ----
KEYWORDS=software engineer, full stack developer, data scientist, ai engineer, machine learning engineer
LOCATION=
# Your years of experience. Used as Naukri's search filter AND to drop postings whose
# experience range does not include it (blank = no filter).
EXPERIENCE_YEARS=2
# A posting whose minimum is up to this many years above EXPERIENCE_YEARS still qualifies (3-5 yrs for a 2-yr candidate)
EXPERIENCE_SLACK=1
PAGES_PER_KEYWORD=2
# Only jobs posted within this many days (1 = last few hours to one day). Blank = no filter.
MAX_JOB_AGE_DAYS=1
# Salary floor in lakhs per annum. Jobs whose disclosed top salary is below this are skipped,
# and the search itself is restricted to Naukri's salary buckets above it.
MIN_SALARY_LPA=10
# 1 = also skip jobs that do not disclose a salary (much stricter, far fewer jobs)
SKIP_UNDISCLOSED_SALARY=0

# ---- Applicant-count filter & ordering ----
# Jobs with more applicants than this are skipped.
MAX_APPLICANTS=100
# Cap for one-click Naukri jobs. 0 = no cap, since they pass 100 within hours of posting.
MAX_APPLICANTS_DIRECT=0
# Hard stop across all runs in one day
DAILY_QUOTA=50
# Tier boundaries for the ordering: all jobs under 50 applicants first (ascending),
# then 50-100, etc. Unknown counts go last.
APPLICANT_TIERS=50,100
# The survey (phase 1) result for a job is reused for this many hours.
SURVEY_CACHE_HOURS=6

# ---- Limits per run ----
MAX_APPLICATIONS=50
MAX_COMPANY_SITE_RESUMES=25

# ---- Behaviour ----
# Seconds the bot waits for you to finish a manual login (OTP / captcha)
LOGIN_WAIT_SECONDS=240
# Random pause between jobs, seconds
MIN_DELAY=6
MAX_DELAY=15
# Chromium is bundled by Playwright. To use Brave/Chrome instead, point this at the binary:
# BROWSER_EXECUTABLE=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
BROWSER_EXECUTABLE=
